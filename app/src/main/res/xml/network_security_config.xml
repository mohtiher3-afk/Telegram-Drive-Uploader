<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Prevent cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Certificate pinning for Telegram servers -->
    <domain-config>
        <domain includeSubdomains="true">telegram.org</domain>
        <domain includeSubdomains="true">t.me</domain>
        <pin-set expiration="2026-01-01">
            <!-- Telegram root CA pins (example - replace with actual pins) -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
