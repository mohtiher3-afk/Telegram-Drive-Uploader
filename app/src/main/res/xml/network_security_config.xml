<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext is blocked app-wide. This is the part of the config that has a real
      effect: any Android-stack HTTPS client in this app refuses plain http://.

      Certificate pinning is deliberately NOT configured here.
      TDLib performs its own TLS through the bundled OpenSSL (libssl/libcrypto) and
      never routes through the Android network stack, so a <pin-set> in this file
      cannot apply to Telegram traffic. The previous revision carried placeholder
      pins ("AAAA...", "BBBB...") with an already-expired expiration date, which
      would have hard-failed every Android-stack request to those domains while
      providing no protection for the traffic it appeared to guard.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
