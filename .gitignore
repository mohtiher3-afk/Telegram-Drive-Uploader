# Local credentials and machine-specific configuration
.env
local.properties
*.jks
*.keystore
google-services.json

# Gradle and Android build outputs
.gradle/
.kotlin/
build/
**/build/
*.apk
*.aab
*.log

# Stray Gradle/CI output written to the repository root by mistake.
# (A leading "-" here would be parsed as a CLI flag, hence the explicit pattern.)
/-test-failures
/-test-failures*
/lint*.log
/help*.log
/test.log

# Built release binaries are distributed via GitHub Releases, never committed.
releases/

# Runtime artifacts produced by smoke/diagnostics scripts (kept out of VCS)
artifacts/

# IDE metadata
.idea/
*.iml
.DS_Store
# Editor config was deliberately untracked in bae2a4d ("stop tracking ... personal
# editor config"), but the rule was never added, so a local .vscode/ keeps showing up
# as untracked noise in `git status`.
.vscode/

# Local Python virtualenv. This repository's scripts only need a system Python 3
# (scripts/*.py run under plain `python3`), so a per-repo .venv is never required and
# was previously untracked-but-unignored, which showed up as noise in `git status`.
.venv/

# IDE build output (Eclipse / VSCode Java language server, and the plain
# `javac` output dir Gradle writes for :domain) writes *.class trees here.
bin/
**/bin/

# Generated native/build intermediates
.externalNativeBuild/
.cxx/
.native-build/
__pycache__/
*.pyc

# Git worktrees
.worktrees/

# Root-level directories that are repository entry points (not nested modules,
# also matching the interface organization):
# .github/  — workflows, dependabot, issue/PR templates
# .clinerules/ — Cline coding-agent workspace rules
# design/   — visual direction system & previews
# docs/     — living documentation; docs/README.md is the index
# gradle/   — version catalogs + plugin management
# scripts/  — verification gates and release helpers
# src/      — unused bucket; do not create content there
.github/
.clinerules/
build/
design/
docs/
gradle/
scripts/
src/

